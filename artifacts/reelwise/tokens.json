{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#ffffff" },
      "foreground": { "$value": "#171b19" },
      "border": { "$value": "#e5e8e6" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#171b19" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#171b19" },
      "primary": {
        "$value": "#171b19",
        "$description": "High-contrast ink used for primary actions, as in the onboarding reference."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": {
        "$value": "#2f7d62",
        "$description": "Reelwise's signature green for progress, selected states, and supportive emphasis."
      },
      "secondaryForeground": { "$value": "#ffffff" },
      "muted": { "$value": "#f5f7f5" },
      "mutedForeground": { "$value": "#747a77" },
      "accent": { "$value": "#eaf4ef" },
      "accentForeground": { "$value": "#3c6555" },
      "destructive": { "$value": "#b42318" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#d9ddda" },
      "ring": { "$value": "#2f7d62" },
      "chart1": { "$value": "#2f7d62" },
      "chart2": { "$value": "#83ad96" },
      "chart3": { "$value": "#c49a62" },
      "chart4": { "$value": "#527f71" },
      "chart5": { "$value": "#947a82" },
      "sidebar": { "$value": "#f7f9f7" },
      "sidebarForeground": { "$value": "#171b19" },
      "sidebarBorder": { "$value": "#e5e8e6" },
      "sidebarPrimary": { "$value": "#2f7d62" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#eaf4ef" },
      "sidebarAccentForeground": { "$value": "#3c6555" },
      "sidebarRing": { "$value": "#2f7d62" }
    },
    "dark": {
      "background": { "$value": "#141a16" },
      "foreground": { "$value": "#f1f5f2" },
      "border": { "$value": "#343d37" },
      "card": { "$value": "#1b231e" },
      "cardForeground": { "$value": "#f1f5f2" },
      "popover": { "$value": "#1b231e" },
      "popoverForeground": { "$value": "#f1f5f2" },
      "primary": { "$value": "#f1f5f2" },
      "primaryForeground": { "$value": "#171b19" },
      "secondary": { "$value": "#2f7d62" },
      "secondaryForeground": { "$value": "#ffffff" },
      "muted": { "$value": "#252e29" },
      "mutedForeground": { "$value": "#aab5ad" },
      "accent": { "$value": "#20362b" },
      "accentForeground": { "$value": "#c8e3d3" },
      "destructive": { "$value": "#f87171" },
      "destructiveForeground": { "$value": "#2a1111" },
      "input": { "$value": "#343d37" },
      "ring": { "$value": "#75b895" },
      "chart1": { "$value": "#75b895" },
      "chart2": { "$value": "#b4d9c2" },
      "chart3": { "$value": "#d5ad76" },
      "chart4": { "$value": "#79a99a" },
      "chart5": { "$value": "#c79ba5" },
      "sidebar": { "$value": "#19211c" },
      "sidebarForeground": { "$value": "#f1f5f2" },
      "sidebarBorder": { "$value": "#343d37" },
      "sidebarPrimary": { "$value": "#2f7d62" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#20362b" },
      "sidebarAccentForeground": { "$value": "#c8e3d3" },
      "sidebarRing": { "$value": "#75b895" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "system-ui", "sans-serif"],
        "$description": "Portable web stand-in for the native system font stack shown in the onboarding reference."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.875rem",
      "$description": "Rounded field and card corners follow the 13–15px treatments in the onboarding reference."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
