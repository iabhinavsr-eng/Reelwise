# Reelwise API — copy to apps/api/.env (git-ignored). SERVER-SIDE SECRETS LIVE HERE ONLY.

PORT=8787

# --- Auth -------------------------------------------------------------------
# supabase (default): verify the app's Supabase access token.
# dev: trust an x-dev-user-id header so the app's local demo mode can talk to
#      the API without Supabase. Refused when NODE_ENV=production.
AUTH_MODE=supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=

# --- Database ---------------------------------------------------------------
# Supabase → Project Settings → Database → connection string (use the pooler URL).
# Empty = in-memory store (dev only; data lost on restart). Ignored when AUTH_MODE=dev.
DATABASE_URL=

# --- AI ---------------------------------------------------------------------
AI_PROVIDER=openai
OPENAI_API_KEY=
# Any Chat Completions model that supports strict JSON-schema structured output.
OPENAI_MODEL=gpt-4.1-mini
# Leave unset for models that only accept the default temperature.
# OPENAI_TEMPERATURE=0.2
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Crawl limits (defaults shown) ------------------------------------------
# CRAWL_MAX_PAGES=15
# CRAWL_MAX_DEPTH=2
# CRAWL_REQUEST_TIMEOUT_MS=10000
# CRAWL_BUDGET_MS=45000
# CRAWL_MAX_RESPONSE_BYTES=2000000
# CRAWL_CONCURRENCY=4

# --- Jobs -------------------------------------------------------------------
# ANALYSIS_CONCURRENCY=3
# ANALYSIS_TIMEOUT_MS=180000
# ANALYSIS_RATE_LIMIT_PER_HOUR=20

# Debug endpoint (/business/analysis/:id/debug). Defaults to on outside production.
# DEBUG_ENDPOINTS=true
# Comma-separated origins for the web preview; defaults to * outside production.
# CORS_ORIGINS=
