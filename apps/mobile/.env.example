# Copy to .env.local (git-ignored) and fill in. Only EXPO_PUBLIC_* values are
# bundled into the app — never put secrets here. AI and crawling keys belong
# on the Reelwise API server (apps/api/.env).

# Leave both empty to run in local demo mode (no backend, data on device).
EXPO_PUBLIC_SUPABASE_URL=
# The anon/publishable key is designed to be public; RLS protects the data.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Reelwise API (apps/api). Empty = on-device mock analysis.
# On a physical iPhone use your computer's LAN IP, e.g. http://192.168.1.20:8787
EXPO_PUBLIC_API_URL=

# Show developer tools (analysis debug view) outside dev builds. Never enable for customers.
# EXPO_PUBLIC_ENABLE_DEBUG_TOOLS=true
