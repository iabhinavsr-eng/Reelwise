# Copy to .env.local (git-ignored) and fill in. Only EXPO_PUBLIC_* values are
# bundled into the app — never put secrets here. AI / crawler keys belong in
# Supabase Edge Function secrets (`supabase secrets set ...`).

# Leave both empty to run in local demo mode (no backend, data on device).
EXPO_PUBLIC_SUPABASE_URL=
# The anon/publishable key is designed to be public; RLS protects the data.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# mock (default): on-device fixtures. edge: call the analyze-business Edge Function.
EXPO_PUBLIC_ANALYSIS_PROVIDER=mock
